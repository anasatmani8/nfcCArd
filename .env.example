# Copy this file to .env.local for local development, and add the same
# variable in your Vercel/Netlify project settings for production.

# Free access key from https://web3forms.com (no signup email required to
# start, just enter the address you want feedback delivered to). Used by
# src/app/api/feedback/route.ts to email private (1-3 star) feedback.
WEB3FORMS_ACCESS_KEY=
